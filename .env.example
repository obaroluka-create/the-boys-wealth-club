# Copy to .env.local and adjust.

# Frontend: where the services send requests.
#   Unset  → mock platform in browser storage (no backend needed).
#   /api   → this app's own API routes (real backend).
NEXT_PUBLIC_API_URL=/api

# Backend database.
#   postgres://user:password@host:5432/dbname  → PostgreSQL (required in production)
#   Unset (development only)                  → embedded PGlite database in .data/pglite
DATABASE_URL=
